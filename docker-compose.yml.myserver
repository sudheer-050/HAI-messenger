services:
  postgres:
    image: postgres:15
    restart: unless-stopped
    environment:
      POSTGRES_USER: 
      POSTGRES_PASSWORD: 
      POSTGRES_DB: 
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --save 60 1

  libretranslate:
    image: libretranslate/libretranslate:latest
    restart: unless-stopped
    environment:
      - LT_LOAD_ONLY=en,es,fr,de,it,pt,ru,zh,ja,ko,ar,hi,bn,ur
      - LT_UPDATE_MODELS=true
      - LT_DISABLE_WEB_UI=true
    ports:
      - "127.0.0.1:5005:5000"
    volumes:
      - libretranslate_models:/home/libretranslate/.local

  # Free, local CPU inference for H. Models persist separately and are pulled
  # explicitly by the operator (for example: ollama pull llama3.2:3b).
  ollama:
    image: ollama/ollama:latest
    restart: unless-stopped
    environment:
      - OLLAMA_KEEP_ALIVE=24h
    ports:
      - "127.0.0.1:11434:11434"
    volumes:
      - ollama_data:/root/.ollama
    healthcheck:
      test: ["CMD", "ollama", "list"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 10s

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      - DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
      - REDIS_URL=redis://redis:6379
      - TRANSLATE_URL=http://libretranslate:5000
      - BASIC_AUTH_USER=${BASIC_AUTH_USER}
      - BASIC_AUTH_PASS=${BASIC_AUTH_PASS}
      - RESEND_API_KEY=${RESEND_API_KEY}
      - JWT_SECRET=${JWT_SECRET}
      - ADMIN_USERNAMES=${ADMIN_USERNAMES}
      - OLLAMA_URL=http://ollama:11434
      - OLLAMA_CHAT_MODEL=${OLLAMA_CHAT_MODEL:-llama3.2:3b}
      - H_OLLAMA_TIMEOUT_MS=${H_OLLAMA_TIMEOUT_MS:-45000}
      - ENABLE_GEMINI_FALLBACK=${ENABLE_GEMINI_FALLBACK:-false}
      - NODE_ENV=production
      - ENFORCE_HTTPS=${ENFORCE_HTTPS:-true}
      - PUBLIC_ORIGIN=${PUBLIC_ORIGIN:-https://myhai.org}
      - H_CHAT_RATE_LIMIT=${H_CHAT_RATE_LIMIT:-10}
      - H_MAX_CONCURRENT_REQUESTS=${H_MAX_CONCURRENT_REQUESTS:-2}
      - GEMINI_API_KEY=${GEMINI_API_KEY}
      - GEMINI_CHAT_MODEL=${GEMINI_CHAT_MODEL}
      - KOKORO_TTS_URL=http://kokoro-tts:8880
      # Job Board sourcing -- free tier at developer.adzuna.com. Missing/blank
      # is safe: fetchAdzunaJobs() just returns no results, RemoteOK still works.
      - ADZUNA_APP_ID=${ADZUNA_APP_ID}
      - ADZUNA_APP_KEY=${ADZUNA_APP_KEY}
      - MULTICA_PROJECT_ID=${MULTICA_PROJECT_ID}
      - MIKA_AGENT_ID=${MIKA_AGENT_ID}
      - MIKA_PARENT_ISSUE_ID=${MIKA_PARENT_ISSUE_ID}
    volumes:
      - multica_config:/root/.multica
    depends_on:
      postgres:
        condition: service_started
      redis:
        condition: service_started
      ollama:
        condition: service_healthy

  analyst:
    build:
      context: /home/myserver56/auto-data-analyst
    restart: unless-stopped
    ports:
      - "127.0.0.1:5001:5000"
    environment:
      - SECRET_KEY=${ANALYST_SECRET_KEY}
    volumes:
      - analyst_uploads:/app/uploads
      - analyst_outputs:/app/outputs

  # Local Kokoro TTS inference — CPU-only, no cloud dependency.
  # Internal-only: backend reaches it as http://kokoro-tts:8880.
  # 127.0.0.1 host port is for manual smoke-testing only.
  # Voice is set via DEFAULT_VOICE; swap it in .env and restart without
  # rebuilding. Model weights are cached in the kokoro_models volume.
  kokoro-tts:
    image: ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.2
    restart: unless-stopped
    environment:
      - DEFAULT_VOICE=${KOKORO_VOICE:-af_heart}
    ports:
      - "127.0.0.1:8880:8880"
    volumes:
      - kokoro_models:/app/models
  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    command: tunnel --no-autoupdate --config /home/nonroot/.cloudflared/config.yml run
    volumes:
      - ./cloudflared:/home/nonroot/.cloudflared
    depends_on:
      - backend
      - analyst

  # Self-hosted STUN/TURN for voice calling (MYAG-219) -- keeps NAT traversal
  # in-house instead of a third-party TURN service, consistent with this
  # app's "no third-party servers" positioning. host networking is used
  # (rather than a long list of published port ranges) because coturn needs
  # the whole min-port..max-port relay range reachable directly; UFW on the
  # host is what actually restricts this to the ports in turnserver.conf --
  # see coturn/turnserver.conf for the port list and relay-abuse hardening.
  #
  # Credentials are never static: TURN_SHARED_SECRET here is used only to
  # verify/mint short-lived (~10 min) HMAC credentials server-side (coturn's
  # REST API mechanism) -- it is never sent to a client. Backend
  # (MYAG-218-BE) needs the same secret + realm to mint matching credentials.
  coturn:
    image: coturn/coturn:4.6.2
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./coturn/turnserver.conf:/etc/coturn/turnserver.conf:ro
    environment:
      - TURN_SHARED_SECRET=${TURN_SHARED_SECRET}
      - TURN_REALM=${TURN_REALM:-turn.myhai.org}
      # Public IP NATed clients must dial to reach this host's relay --
      # myserver has no public IP of its own (home-router NAT). Must be kept
      # current if the ISP's assigned IP changes; see coturn/README.md.
      - TURN_EXTERNAL_IP=${TURN_EXTERNAL_IP}
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        exec turnserver -c /etc/coturn/turnserver.conf \
          --realm="$$TURN_REALM" \
          --static-auth-secret="$$TURN_SHARED_SECRET" \
          --external-ip="$$TURN_EXTERNAL_IP"

volumes:
  multica_config:
  pgdata:
  libretranslate_models:
  redis_data:
  ollama_data:
  analyst_uploads:
  analyst_outputs:
  kokoro_models:
