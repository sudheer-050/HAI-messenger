POSTGRES_USER=chat_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chat_db
# Get a free API key at resend.com — used to send signup verification emails.
# With no custom domain verified, Resend's shared sender can only deliver to
# the email address your Resend account itself is registered under.
RESEND_API_KEY=re_your_resend_api_key
# Any long random string — signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ──────────────────────────────────────────────────────────────────────────────
# MIKA BRIDGE — admin-only chat integration with the Multica agent platform.
# The server talks to Multica ONLY through the `multica` CLI (never a REST call
# with a bearer token) — there is no documented public Multica REST API to call
# directly, and the CLI is the one verified, supported integration surface.
#
# MANUAL PROVISIONING REQUIRED — this is NOT set via these env vars:
#   The `multica` CLI must be installed and authenticated on the host/container
#   running backend/server.js, under a service identity that is allowed to
#   create issues (assigned to Mika) in the project below. There is currently
#   no way to provision this from inside the repo/env file; it's a one-time
#   operational step (install the CLI in the backend image, then run its login/
#   daemon setup for that service identity) that must be done outside of git.
#
# MULTICA_PROJECT_ID, MIKA_AGENT_ID and MIKA_PARENT_ISSUE_ID are all required
# for the /api/admin/mika/message endpoint to be live. If any are absent the
# endpoint returns 503; the rest of the app is unaffected.
# ──────────────────────────────────────────────────────────────────────────────
# Project UUID — the HAI Messenger project bridge issues are created in.
MULTICA_PROJECT_ID=project-uuid-here
# Agent UUID for Mika — bridge issues are assigned to this agent, and only a
# comment authored by this exact agent id is ever relayed back to the admin.
MIKA_AGENT_ID=agent-uuid-here
# Parent issue UUID — bridge issues are created as children of this issue so
# they stay organized and scoped.
MIKA_PARENT_ISSUE_ID=parent-issue-uuid-here
# Optional — only needed if the authenticated CLI identity has access to more
# than one workspace and the bridge needs to target a specific one.
# MULTICA_WORKSPACE_ID=workspace-uuid-here
# Optional — override if the `multica` binary isn't on PATH. Defaults to "multica".
# MULTICA_CLI_PATH=/usr/local/bin/multica
