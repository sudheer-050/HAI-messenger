POSTGRES_USER=chat_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chat_db
# Get a free API key at resend.com — used to send signup verification emails.
# With no custom domain verified, Resend's shared sender can only deliver to
# the email address your Resend account itself is registered under.
RESEND_API_KEY=re_your_resend_api_key
# Any long random string — signs session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ──────────────────────────────────────────────────────────────────────────────
# MIKA BRIDGE — admin-only chat integration with the Multica agent platform.
# All six vars are required for the /api/admin/mika/message endpoint to be live.
# If any are absent the endpoint returns 503; the rest of the app is unaffected.
# NEVER commit real values here — rotate immediately if any are accidentally leaked.
# ──────────────────────────────────────────────────────────────────────────────
# Multica API bearer token (from multica auth or a workspace service-account token).
MULTICA_API_TOKEN=multica_token_here
# Multica platform REST API base URL (no trailing slash).
MULTICA_SERVER_URL=https://api.multica.ai
# Workspace UUID — found in the Multica workspace settings or `multica config show`.
MULTICA_WORKSPACE_ID=workspace-uuid-here
# Project UUID — the HAI Messenger project in that workspace.
MULTICA_PROJECT_ID=project-uuid-here
# Agent UUID for Mika (the agent that will receive and answer bridge issues).
MIKA_AGENT_ID=agent-uuid-here
# Parent issue UUID — bridge issues are created as children of this issue so they
# stay organized and the agent's workspace filter covers them.
MIKA_PARENT_ISSUE_ID=parent-issue-uuid-here
